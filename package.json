{
  "name": "coffee-roulette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": ".venv/bin/uvicorn api.index:app --reload --port 8000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "vercel": "^59.10.0",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true
  }
}
